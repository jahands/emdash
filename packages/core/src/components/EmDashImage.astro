---
/**
 * EmDash Image component
 *
 * Renders images with responsive srcset for CDN providers that support it.
 * Uses the provider's getSrc function for URL-based image transformations.
 *
 * Usage:
 * ```astro
 * ---
 * import { Image } from "emdash/ui";
 * ---
 * <Image image={post.data.featured_image} />
 *
 * <!-- With overrides -->
 * <Image image={post.data.featured_image} class="hero" />
 * ```
 *
 * When the image value carries a `darkVariant`, both images are rendered and
 * CSS shows the one matching the page's color scheme. See the dark mode guide
 * for the `<html>` class convention and how to override the selectors.
 */
import type { ImageValue, MediaValue } from "../fields/types.js";
import type { HTMLAttributes } from "astro/types";
import type { LocalImageProps } from "astro:assets";
import { getImage, imageConfig } from "astro:assets";
import virtualConfig from "virtual:emdash/config";
import type { ImageTransformFormat } from "../media/image-endpoint.js";
import type { ImageEmbed } from "../media/types.js";
import { getMediaProvider } from "../media/provider-loader.js";
import { normalizeLegacyExternalMediaValue } from "../media/normalize.js";
import { buildRenderMediaUrl } from "../media/url.js";
import {
	buildResponsiveImage,
	formatContentType,
	mediaImageOrigin,
	optimizeImage,
	toAbsoluteMediaUrl,
	responsiveSizes,
	responsiveWidths,
	type OptimizedImage,
} from "../media/responsive.js";
import { getPublicOrigin } from "../api/public-url.js";
import { focalPointToObjectPosition } from "../media/focal-point.js";

interface Props extends Omit<
	HTMLAttributes<"img">,
	"src" | "width" | "height"
> {
	/** Image value from content field or media library */
	image: ImageValue | string | undefined | null;
	/**
	 * Image shown in a dark color scheme. Defaults to `image.darkVariant`;
	 * pass it explicitly when the dark image comes from another field.
	 */
	darkVariant?: MediaValue | string | undefined | null;
	/** Override alt text (uses image.alt by default) */
	alt?: string;
	/** Override width (uses image.width by default) */
	width?: number;
	/** Override height (uses image.height by default) */
	height?: number;
	/** Output quality for Astro's image service or providers that support it. */
	quality?: LocalImageProps["quality"];
	/** Priority loading (disables lazy loading) */
	priority?: boolean;
	/** Render the LQIP placeholder as an inline background. Disable for strict CSP. */
	placeholder?: boolean;
	/**
	 * Output formats, most preferred first. With more than one format the
	 * component renders a `<picture>`: the last entry becomes the `<img>` and
	 * the others become `<source>` elements in order. With `fallbackFormat`,
	 * that format becomes the `<img>` and every entry becomes a `<source>`.
	 * Only applies to media optimized by the site's image service; images from
	 * external media providers keep the provider's own URLs.
	 */
	formats?: ImageTransformFormat[];
	/** Format for the fallback `<img>` when `formats` is set. Defaults to the last entry of `formats`. */
	fallbackFormat?: ImageTransformFormat;
}

const {
	image,
	darkVariant,
	alt,
	width,
	height,
	quality,
	priority,
	placeholder = true,
	formats,
	fallbackFormat,
	class: className,
	id,
	...attrs
} = Astro.props;

// Normalize string URLs to object form
function normalizeImage(
	img: MediaValue | string | undefined | null
): MediaValue | null {
	if (!img) return null;
	if (typeof img === "string") {
		return { id: "", src: img };
	}
	return normalizeLegacyExternalMediaValue(img);
}

/**
 * Build the URL for a local image. Prefers `meta.storageKey`; falls back to
 * the internal proxy with `img.id` when no storage key is available.
 */
function buildLocalImageUrl(img: MediaValue): string {
	return buildRenderMediaUrl(Astro.locals.emdash?.getPublicMediaUrl, {
		storageKey: img.meta?.storageKey as string | undefined,
		id: img.id,
	});
}

/**
 * Generate srcset using provider's getSrc function
 */
function generateSrcset(
	getSrc: NonNullable<ImageEmbed["getSrc"]>,
	maxWidth: number,
	aspectRatio?: number,
	originalWidth?: number
): string {
	return responsiveWidths(maxWidth, originalWidth)
		.map((w) => {
			const h = aspectRatio ? Math.round(w / aspectRatio) : undefined;
			return `${getSrc({ width: w, height: h, quality })} ${w}w`;
		})
		.join(", ");
}

// The fallback `<img>` uses the last requested format unless overridden. With
// an explicit `fallbackFormat`, every `formats` entry stays a `<source>`.
const imgFormat = formats?.length ? (fallbackFormat ?? formats.at(-1)) : undefined;
const sourceFormats = formats?.length ? (fallbackFormat ? formats : formats.slice(0, -1)) : [];
const outputFormats = [...new Set([imgFormat, ...sourceFormats])];

interface ResolvedImage {
	src: string;
	srcset?: string;
	sizes?: string;
	/** The `<img>` Astro's image service produced for same-origin media. */
	optimized: OptimizedImage | null;
	width?: number;
	height?: number;
	generatedStyle: string;
	/** Per-format `<source>` data when this render needs a `<picture>`. */
	sources: { type: string; srcset: string; sizes?: string }[];
}

/**
 * Resolve the source URL, srcset, dimensions, and LQIP style for one media
 * value. Props override the value's own dimensions.
 */
async function resolveImage(
	img: MediaValue,
	variant: { className: string | undefined; id: string | null | undefined }
): Promise<ResolvedImage> {
	const finalWidth = width ?? img.width;
	const finalHeight = height ?? img.height;
	const aspectRatio =
		finalWidth && finalHeight ? finalWidth / finalHeight : undefined;

	let src = "";
	let srcset: string | undefined;
	let sizes: string | undefined;
	let optimized: OptimizedImage | null = null;
	const sources: ResolvedImage["sources"] = [];

	const providerId = img.provider ?? "local";
	// Build placeholder background style. Prefer the first-class MediaValue fields;
	// fall back to `meta` for snapshots stored before LQIP was promoted off `meta`.
	const blurhash = img.blurhash ?? (img.meta?.blurhash as string | undefined);
	const dominantColor =
		img.dominantColor ?? (img.meta?.dominantColor as string | undefined);

	let placeholderStyle = "";
	if (placeholder && blurhash) {
		const { blurhashToImageCssString } = await import("@unpic/placeholder");
		placeholderStyle = blurhashToImageCssString(blurhash);
	} else if (placeholder && dominantColor) {
		placeholderStyle = `background-color: ${dominantColor};`;
	}

	// The focal point travels with the media value, so the dark variant gets
	// its own object-position rather than inheriting the light image's.
	const objectPosition = focalPointToObjectPosition(img.focalX, img.focalY);
	const normalizedPlaceholder =
		placeholderStyle && !placeholderStyle.endsWith(";")
			? `${placeholderStyle};`
			: placeholderStyle;
	const generatedStyle = [
		normalizedPlaceholder,
		objectPosition ? `object-position: ${objectPosition};` : "",
	]
		.filter(Boolean)
		.join(" ");


	if (providerId === "local" || img.src) {
		src = img.src || buildLocalImageUrl(img);
		const origin = mediaImageOrigin({
			internalOrigin: virtualConfig?.internalMediaOrigin,
			isPrerendered: Astro.isPrerendered,
			publicOrigin: () => getPublicOrigin(Astro.url, Astro.locals.emdash?.config),
		});
		const absoluteSrc = toAbsoluteMediaUrl(src, origin);
		if (finalWidth && finalHeight && absoluteSrc.startsWith(`${origin}/`)) {
			const imageOptions = {
				id: variant.id,
				alt: finalAlt,
				width: finalWidth,
				height: finalHeight,
				originalWidth: img.width,
				quality,
				priority,
				layout: "constrained",
				loading: priority ? "eager" : "lazy",
				decoding: "async",
				class: astroClass(variant.className),
				style: generatedStyle || undefined,
				...attrs,
				src: absoluteSrc,
			};
			const fallback = await optimizeImage(getImage, imageConfig, {
				...imageOptions,
				...(imgFormat !== undefined ? { format: imgFormat } : {}),
			});
			const alternates = fallback
				? await Promise.all(
						sourceFormats.map((format) =>
							optimizeImage(getImage, imageConfig, { ...imageOptions, format }).then(
								(alternate) => ({ format, alternate }),
							),
						),
					)
				: [];
			if (fallback && alternates.every(({ alternate }) => alternate)) {
				optimized = fallback;
				const sourceSizes = attrs.sizes ?? responsiveSizes(finalWidth);
				for (const { format, alternate } of alternates) {
					if (!alternate?.srcset) continue;
					sources.push({
						type: formatContentType(format),
						srcset: alternate.srcset,
						sizes: sourceSizes,
					});
				}
			}
		} else {
			const responsive = await buildResponsiveImage(getImage, {
				src: absoluteSrc,
				width: finalWidth,
				height: finalHeight,
				originalWidth: img.width,
				format: imgFormat,
				quality,
			});
			if (responsive) {
				src = responsive.src;
				srcset = responsive.srcset;
				sizes = responsive.sizes;
				const alternates = await Promise.all(
					sourceFormats.map((sourceFormat) =>
						sourceFormat === imgFormat
							? Promise.resolve({ sourceFormat, alternate: responsive })
							: buildResponsiveImage(getImage, {
									src: absoluteSrc,
									width: finalWidth,
									height: finalHeight,
									originalWidth: img.width,
									format: sourceFormat,
									quality,
								}).then((alternate) => ({ sourceFormat, alternate })),
					),
				);
				for (const { sourceFormat, alternate } of alternates) {
					if (!alternate) continue;
					sources.push({
						type: formatContentType(sourceFormat),
						srcset: alternate.srcset || alternate.src,
						sizes: alternate.srcset ? (attrs.sizes ?? alternate.sizes) : undefined,
					});
				}
			}
		}
	} else {
		// External provider
		try {
			const provider = await getMediaProvider(providerId);
			if (provider) {
				const result = provider.getEmbed(img, {
					width: finalWidth,
					height: finalHeight,
					quality,
				});
				const embed = result instanceof Promise ? await result : result;
				if (embed.type === "image") {
					src = embed.src;

					// Generate srcset if provider supports dynamic sizing
					if (embed.getSrc) {
						// Use image width, or default to 1200 for responsive images
						const maxWidth = finalWidth || 1200;
						srcset = generateSrcset(embed.getSrc, maxWidth, aspectRatio, img.width);
						sizes = finalWidth
							? `(min-width: ${finalWidth}px) ${finalWidth}px, 100vw`
							: "100vw";
					}
				}
			} else {
				console.warn(`[EmDashImage] Provider not found: ${providerId}`);
			}
		} catch (error) {
			console.error(
				`[EmDashImage] Failed to get embed for image ${img.id}:`,
				error
			);
		}

		// Fallback to local URL if provider failed
		if (!src) {
			src = buildLocalImageUrl(img);
		}
	}

	return {
		src,
		srcset,
		sizes,
		optimized,
		width: finalWidth,
		height: finalHeight,
		generatedStyle,
		sources,
	};
}

const img = normalizeImage(image);
const darkSource =
	darkVariant ?? (typeof image === "object" ? image?.darkVariant : undefined);
const dark = img ? normalizeImage(darkSource) : null;
const finalAlt = alt ?? img?.alt ?? "";

const lightClass = dark ? "emdash-image--light" : undefined;
// Both variants render into the same document, so a caller-supplied `id` would
// otherwise appear on two elements.
const darkId = id ? `${id}--dark` : undefined;
function astroClass(variantClass: string | undefined) {
	return [variantClass, className].filter(Boolean).join(" ") || undefined;
}

const resolved = img ? await resolveImage(img, { className: lightClass, id }) : null;
const resolvedDark = dark
	? await resolveImage(dark, { className: "emdash-image--dark", id: darkId })
	: null;

function imgProps(
	r: ResolvedImage,
	variantClass: string | undefined,
	elementId: string | null | undefined
): Record<string, unknown> {
	if (r.optimized) {
		return { src: r.optimized.src, srcset: r.optimized.srcset, ...r.optimized.attributes };
	}
	return {
		id: elementId,
		src: r.src,
		srcset: r.srcset,
		sizes: r.sizes,
		width: r.width,
		height: r.height,
		alt: finalAlt,
		loading: priority ? "eager" : "lazy",
		fetchpriority: priority ? "high" : undefined,
		decoding: "async",
		style: r.generatedStyle || undefined,
		class: ["emdash-image-media", variantClass, className].filter(Boolean).join(" "),
		...attrs,
	};
}
---

{
	resolved && (resolved.optimized || resolved.src) ? (
		resolved.sources.length ? (
			<picture class={lightClass}>
				{resolved.sources.map((source) => (
					<source type={source.type} srcset={source.srcset} sizes={source.sizes} />
				))}
				<img {...imgProps(resolved, lightClass, id)} />
			</picture>
		) : (
			<img {...imgProps(resolved, lightClass, id)} />
		)
	) : null
}
{
	resolvedDark && (resolvedDark.optimized || resolvedDark.src) ? (
		resolvedDark.sources.length ? (
			<picture class="emdash-image--dark">
				{resolvedDark.sources.map((source) => (
					<source type={source.type} srcset={source.srcset} sizes={source.sizes} />
				))}
				<img {...imgProps(resolvedDark, "emdash-image--dark", darkId)} />
			</picture>
		) : (
			<img {...imgProps(resolvedDark, "emdash-image--dark", darkId)} />
		)
	) : null
}

<style>
	.emdash-image-media {
		max-width: 100%;
		height: auto;
	}
</style>

<style is:global>
	/* A `dark` or `light` class on <html> wins over the system preference. */
	:where(:root.dark) .emdash-image--light {
		display: none;
	}
	:where(:root.light) .emdash-image--dark {
		display: none;
	}
	@media (prefers-color-scheme: dark) {
		:where(:root:not(.light)) .emdash-image--light {
			display: none;
		}
	}
	@media (prefers-color-scheme: light) {
		:where(:root:not(.dark)) .emdash-image--dark {
			display: none;
		}
	}
</style>
